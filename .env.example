# ─── Supabase (leave empty to run on the built-in in-memory store) ───
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Access ───
# Passphrase for /admin. CHANGE THIS before the event.
ADMIN_KEY=override-admin
# Long random string used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
# Optional gate for self-registration at /login. Empty = anyone with the URL can register a team.
EVENT_JOIN_CODE=

# ─── Question generation ───
# With a key, every team gets its own Gemini-generated question set for SCAN, DECODE, ESCAPE,
# OVERDRIVE and OVERRIDE. Without one (or if Gemini fails), sets are randomized locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ─── Memory store persistence (ignored when Supabase is configured) ───
DATA_FILE=.data/arena.json
